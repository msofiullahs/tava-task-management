APP_NAME=Tava
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Database — MySQL/MariaDB.
#
# DB_HOST values you'll actually use:
#   * `db`        — docker-compose only (it's the service name in docker-compose.yml).
#                   Inside the app container this resolves via Docker's network DNS.
#   * `localhost` — every other deployment, including Plesk-managed MariaDB,
#                   shared hosting, bare-metal MySQL. The database is on the same box.
#   * a hostname  — external/remote DB server.
#
# Tava is Plesk-friendly by design:
#   * VARCHAR is capped at 191 chars in AppServiceProvider, so utf8mb4 indexes stay
#     under the 767-byte limit on older InnoDB row formats (Antelope).
#   * No JSON columns are used — schema deploys on MariaDB versions that lack JSON.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=tava
DB_USERNAME=tava
DB_PASSWORD=changeme

# Sanctum / session — same-domain SPA + API. Replace localhost with your app host.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8080,127.0.0.1,127.0.0.1:8080
SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
