* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore

# Built frontend assets are committed for Plesk-style deploys (see README).
# Hide them from PR diffs + repo language stats — they're minified machine output,
# not something a human reviews. Re-generated by `npm run build` every push.
public/build/** linguist-generated=true
public/build/** -diff
public/build/** -merge
